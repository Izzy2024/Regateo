{
  "name": "regateoapp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "bun --filter @regateo/api dev",
    "dev:web": "bun --filter @regateo/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint apps packages scripts",
    "format": "biome format --write apps packages scripts",
    "db:push": "bun --filter @regateo/db db:push",
    "db:generate": "bun --filter @regateo/db db:generate",
    "db:studio": "bun --filter @regateo/db db:studio",
    "scrape": "bun --filter @regateo/scraper scrape",
    "scrape:radar": "bun scripts/scrape-radar.ts",
    "scrape:full": "bun scripts/scrape-radar.ts --full",
    "scrape:schedule": "bun --filter @regateo/scraper schedule"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/bun": "^1.2.15",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  },
  "overrides": {
    "drizzle-orm": "^0.45.4"
  }
}
