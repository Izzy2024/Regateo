# ============================================
# RegateoApp - Variables de Entorno (2026)
# ============================================

# Base de Datos (Usar SIEMPRE URL de Connection Pooling en producción: Neon -pooler o Supabase :6543)
DATABASE_URL=postgresql://admin@localhost:5432/regateoapp_dev
DATABASE_POOLER=false

# Servidor API (Hono) & Frontend (Vercel / CF Pages)
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Better Auth (Subdominios hermanos en prod: app.regateoapp.com y api.regateoapp.com)
BETTER_AUTH_SECRET=dev-regateoapp-super-secret-key-change-in-production-32chars
BETTER_AUTH_URL=http://localhost:3001
COOKIE_DOMAIN=

# Protección Anti-Bot / CAPTCHA (Cloudflare Turnstile en producción; en local usa desafío firmado integrado)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Scraping con Firecrawl (Cloud API, Self-Hosted local o CLI autenticado)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
SCRAPE_INTERVAL_DAYS=3
CRON_SECRET=dev-cron-secret-regateoapp

# Caché y Rate Limiting (Upstash Redis — fallback automático en memoria en desarrollo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Capa IA Gateway (DeepSeek API o OpenRouter / LiteLLM — nunca llamar proveedores desde el cliente)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek-chat

# Observabilidad & Analítica (Opcionales en dev, activos en producción)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
